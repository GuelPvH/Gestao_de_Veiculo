{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "software-house/programacao-para-web",
    "type": "project",
    "description": "Software House - ambiente Laravel integralmente containerizado.",
    "keywords": ["laravel", "docker", "software-house"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.17",
        "laravel/horizon": "^5.48",
        "laravel/pulse": "^1.8",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.35",
        "sentry/sentry-laravel": "^4.27",
        "spatie/laravel-backup": "^10.3"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "captainhook/captainhook": "*",
        "captainhook/hook-installer": "*",
        "driftingly/rector-laravel": "^2.5",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpunit/phpunit": "^13.2.4",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "//": [
            "Os scripts `setup` e `dev` do skeleton foram removidos: ambos chamavam",
            "npm/artisan pressupondo Node e um servidor embutido no host. Aqui quem",
            "orquestra e o compose — use `make setup` (ou .\\make.ps1 setup)."
        ],
        "lint": "./vendor/bin/pint --test",
        "lint:fix": "./vendor/bin/pint --dirty",
        "analyse": "./vendor/bin/phpstan analyse --memory-limit=1G",
        "refactor": "./vendor/bin/rector process --dry-run",
        "test": [
            "@php artisan config:clear --ansi",
            "./vendor/bin/pest"
        ],
        "check": [
            "@lint",
            "@refactor",
            "@analyse",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "captainhook/hook-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
