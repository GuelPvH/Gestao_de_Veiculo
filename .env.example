# =============================================================================
# Modelo de ambiente. Copie para `.env` e ajuste.
#
#   Windows / PowerShell : Copy-Item .env.example .env
#   Linux / macOS        : cp .env.example .env
#
# `.env` NUNCA é versionado nem entra na imagem (ver .gitignore / .dockerignore).
# Senhas: gere valores fortes SEM o caractere `$` — o Docker Compose interpola
# `${...}` neste arquivo e um `$` solto chega truncado ao container.
# =============================================================================

# -----------------------------------------------------------------------------
# Compose
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=software-house-ppw
# Sobe phpMyAdmin e Mailpit junto com o restante. Deixe vazio para não subi-los.
COMPOSE_PROFILES=tools

# ---------------------------------------------------------------------------
# NOME DOS CONTAINERS — escolha o seu.
#
# O valor abaixo é só uma sugestão. Coloque o que fizer sentido para você:
# `frota`, `meuapp`, `veiculo`, o que preferir. Os containers passam a se
# chamar <prefixo>_app, <prefixo>_mysql, <prefixo>_nginx, e é esse nome que
# você usa no dia a dia:
#
#     docker exec -it <prefixo>_app bash
#
# Se você apagar esta linha, o Compose cai no COMPOSE_PROJECT_NAME acima e,
# na falta dele, no nome da pasta — que é o comportamento padrão do Docker.
#
# Nome de container é único por máquina: se for rodar duas cópias deste
# projeto ao mesmo tempo, dê prefixos diferentes a cada uma.
# ---------------------------------------------------------------------------
CONTAINER_PREFIX=software-house

# -----------------------------------------------------------------------------
# Portas publicadas no HOST. Conflito de porta se resolve AQUI, nunca no compose.
# -----------------------------------------------------------------------------
APP_PORT=8000
VITE_PORT=5175
PHPMYADMIN_PORT=8082
MAILPIT_PORT=8026

# -----------------------------------------------------------------------------
# Build da imagem
#   APP_UID/APP_GID valem para os containers PHP **e** Node: os dois gravam no
#   mesmo bind mount e precisam da mesma identidade — com uids diferentes o
#   Vite não consegue criar `public/hot`.
#   Só importam em Linux nativo (alinhe com `id -u` / `id -g`). Em Docker
#   Desktop (Windows/macOS) o mapeamento é automático — mantenha 82/82, que é
#   o uid/gid do www-data no Alpine.
# -----------------------------------------------------------------------------
PHP_VERSION=8.4
NODE_VERSION=24
APP_UID=82
APP_GID=82

# Xdebug fica DESLIGADO por padrão (degrada cada request em 2–3x).
# Ligue sob demanda:  XDEBUG_MODE=debug
XDEBUG_MODE=off

# -----------------------------------------------------------------------------
# Laravel
# -----------------------------------------------------------------------------
APP_NAME="Software House"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Sem APP_TIMEZONE: o skeleton do Laravel 13 fixa 'UTC' em config/app.php e não
# lê essa variável. Manter a chave aqui seria configuração morta. O Laravel
# armazena em UTC por convenção — converta na exibição.

LOG_CHANNEL=stack
# dev: stderr_pretty (legível no terminal)
# prod: stderr_json (indexável por Loki/CloudWatch/Datadog)
LOG_CHANNEL_STACK=stderr_pretty
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Banco — DB_HOST é o NOME DO SERVIÇO no compose, nunca localhost/127.0.0.1.
# Dentro de um container, `localhost` é o próprio container.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=Software_House
DB_USERNAME=Software_House
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# -----------------------------------------------------------------------------
# Redis / cache / fila / sessão
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# E-mail — Mailpit captura tudo, nada sai para a internet.
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null

# Sem MAIL_ENCRYPTION: o Laravel 11 substituiu essa chave por MAIL_SCHEME
# (config/mail.php), e a antiga passou a ser lida por ninguém. Com Mailpit não
# há TLS, então MAIL_SCHEME também fica de fora — o padrão já é o correto aqui.
# Chave que ninguém lê é pior que chave ausente: quem preenche acha que
# configurou. O teste tests/Architecture/EnvExampleTest.php cobra isso.
MAIL_FROM_ADDRESS="nao-responda@software-house.test"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Ferramentas de desenvolvimento
# Debugbar fica DESLIGADA por padrão: ligada, coleta dados em toda request.
# -----------------------------------------------------------------------------
DEBUGBAR_ENABLED=false

# -----------------------------------------------------------------------------
# Sanctum — dois modos:
#   Cookie (SPA mesmo domínio): configure SANCTUM_STATEFUL_DOMAINS
#   Token (mobile/integração): $user->createToken('nome')->plainTextToken
# -----------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000
SANCTUM_EXPIRATION=10080
SESSION_DOMAIN=localhost

# -----------------------------------------------------------------------------
# Sentry — DSN é credencial de sistema externo (§2.3): NÃO invente.
# Copie do painel do Sentry → Settings → Client Keys.
# Sem DSN o pacote simplesmente não reporta nada — sem erro.
# TRACES_SAMPLE_RATE=0.2 em produção, 0 em dev (cada teste vira um evento).
# -----------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ENVIRONMENT=${APP_ENV}

# -----------------------------------------------------------------------------
# Horizon (dashboard de filas Redis)
# -----------------------------------------------------------------------------
HORIZON_PREFIX=software-house-ppw_horizon:

# -----------------------------------------------------------------------------
# Backup (spatie/laravel-backup) — disco S3 ou equivalente remoto.
# Credenciais são sistema externo (§2.3): NÃO invente.
# Sem estas chaves o backup NÃO funciona — pendência documentada.
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
