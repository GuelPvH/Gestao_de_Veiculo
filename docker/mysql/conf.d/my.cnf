[mysqld]

# utf8mb4 é o único charset que cobre o Unicode inteiro (emoji incluído).
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci

# Sem DNS reverso a cada conexão: dentro da rede do compose isso só adiciona
# latência e falhas intermitentes.
skip-name-resolve

max_connections          = 200
innodb_buffer_pool_size  = 256M
innodb_flush_log_at_trx_commit = 2

# Consultas lentas ficam visíveis em desenvolvimento.
slow_query_log      = 1
long_query_time     = 1
slow_query_log_file = /var/lib/mysql/slow.log

# MySQL 8.4 removeu `default_authentication_plugin` e o `mysql_native_password`.
# O default (caching_sha2_password) é suportado pelo mysqlnd do PHP 8.4, então
# nada precisa ser afrouxado aqui.

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
